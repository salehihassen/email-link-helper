# Pass to the app container as its env file (for example docker run --env-file).
PUBLIC_ORIGIN=https://links.private.example
WEB_USERNAME=admin
POLL_SECONDS=5
MAX_AGE_SECONDS=600
MAIL_PROVIDERS=proton
MAIL_PROTON_TYPE=bridge
MAIL_PROTON_LABEL=Personal
MAIL_PROTON_USERNAME=replace-with-bridge-username
MAIL_PROTON_MAILBOXES=INBOX,Archive
MAIL_PROTON_AUTHSERV_IDS=mail.protonmail.ch
# Passwords: /run/secrets/<provider>-imap-password (recommended), then
# MAIL_<PROVIDER>_PASSWORD, then encrypted password from the settings UI.
# Another provider (use its actual receiving Authentication-Results ID):
# MAIL_PROVIDERS=proton,work
# MAIL_WORK_TYPE=imap
# MAIL_WORK_HOST=imappro.zoho.com
# MAIL_WORK_PORT=993
# MAIL_WORK_LABEL=Work
# MAIL_WORK_USERNAME=replace-with-mailbox-username
# MAIL_WORK_MAILBOXES=INBOX
# MAIL_WORK_AUTHSERV_IDS=replace-with-receiving-authentication-results-id
# LINK_RULES_JSON optionally sets and locks a JSON array of rules.
